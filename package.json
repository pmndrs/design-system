{
  "name": "@pmndrs/design-system",
  "version": "0.9.0",
  "private": true,
  "description": "The shared pmndrs colour layer (Material Design 3) and the poimandres shadcn preset",
  "license": "MIT",
  "homepage": "https://github.com/pmndrs/design-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/design-system.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "artifact": "node scripts/artifact.mjs",
    "hosted-registry": "node scripts/hosted-registry.mjs",
    "refresh-catalog": "node scripts/catalog.mjs && npm run build",
    "check-registry": "shadcn registry validate ./registry.json",
    "test": "node --test",
    "lgtm": "npm run check-registry && npm test && npm run check-storybook",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only && npm run build",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o out/storybook",
    "check-storybook": "tsc -p .storybook/tsconfig.json && npm run build-storybook"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "material-theme-builder": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
