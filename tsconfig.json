{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/registry/*": ["./node_modules/@pmndrs/docs/registry/*"],
      "@/*": ["./node_modules/@pmndrs/docs/src/*"]
    }
  },
  "include": ["registry", "scripts"]
}
