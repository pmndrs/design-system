{
  "name": "@pmndrs/design-system",
  "version": "0.9.0",
  "private": true,
  "description": "The shared pmndrs colour layer (Material Design 3) and the poimandres shadcn preset",
  "license": "MIT",
  "homepage": "https://github.com/pmndrs/design-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/design-system.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "hosted-registry": "node scripts/hosted-registry.mjs",
    "refresh-catalog": "node scripts/catalog.mjs && pnpm run build",
    "check-registry": "shadcn registry validate ./registry.json",
    "test": "node --test",
    "lgtm": "pnpm run check-registry && pnpm run check-docs && pnpm test && pnpm run check-storybook",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile && pnpm run build",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o out/storybook",
    "check-storybook": "tsc -p .storybook/tsconfig.json && pnpm run build-storybook",
    "build-docs": "pmndrs-docs build docs out/site --format website",
    "check-docs": "tsc -p tsconfig.docs.json",
    "build-docs:fragments": "pmndrs-docs build docs out/fragments --config docs.config.fragment.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pmndrs/docs": "4.25.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.56.0",
    "material-theme-builder": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.33.4"
}
